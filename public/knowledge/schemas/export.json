{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://donovan-amx.vercel.app/knowledge/schemas/export.json",
  "title": "Calpulli CDMXKnowledgeExport",
  "description": "Envelope for every file under /knowledge/*.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "entity", "total", "count", "data"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "entity": { "type": "string" },
    "total": { "type": "integer", "minimum": 0 },
    "count": { "type": "integer", "minimum": 0 },
    "data": { "type": "array" }
  }
}
